rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 모든 사용자가 읽기 가능
    match /{document=**} {
      allow read: if true;
    }

    // 인증된 사용자만 쓰기 가능
    match /quizzes/{quizId} {
      allow create, update, delete: if request.auth != null;
    }

    match /surveys/{surveyId} {
      allow create, update, delete: if request.auth != null;
    }

    match /quizSessions/{sessionId} {
      allow create, update: if true; // 참여자도 답안 제출 가능
    }

    match /surveySessions/{sessionId} {
      allow create, update: if true; // 참여자도 응답 제출 가능
    }

    // 사용자 승인 관련 (관리자만)
    match /pendingUsers/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null; // 관리자 확인은 앱에서 처리
    }

    match /approvedUsers/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // 사용자 시트 정보
    match /userSheets/{sheetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 논의 자료 (업무) 관리
    match /discussionTopics/{topicId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // 부서 관리
    match /departments/{deptId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // 의견 수집 세션
    match /opinionSessions/{sessionId} {
      allow read: if true; // 참여자도 읽기 가능
      allow create, update: if request.auth != null; // 인증된 사용자만 생성/수정
      allow delete: if request.auth != null; // 인증된 사용자만 삭제

      // 의견 서브컬렉션
      match /opinions/{opinionId} {
        allow read: if true; // 참여자도 읽기 가능 (실시간 통계)
        allow create: if true; // 참여자도 의견 제출 가능
        allow delete: if request.auth != null; // 인증된 사용자만 삭제
      }
    }
  }
}
