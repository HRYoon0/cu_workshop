# Firebase 설정
# Firebase 콘솔 (https://console.firebase.google.com/)에서 프로젝트를 생성하고
# 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성에서 아래 값들을 확인할 수 있습니다.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# 관리자 UID
# Google 로그인 후 Firebase Console의 Authentication 섹션에서 UID를 확인할 수 있습니다.
# 여기에 본인의 UID를 입력하세요.
NEXT_PUBLIC_ADMIN_UID=your-admin-uid

# 관리자 이메일 (시트 편집 권한용)
# 사용자별 시트에 관리자가 자동으로 데이터를 기록하기 위해 필요합니다.
# Google 계정 이메일 주소를 입력하세요.
NEXT_PUBLIC_ADMIN_EMAIL=your-email@gmail.com

# Google Drive API
# Google Cloud Console에서 생성한 OAuth 2.0 클라이언트 ID
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your-client-id

# 구글 시트 템플릿 ID (사용자별 자동 복사용)
# SHEET_TEMPLATE_SETUP.md 파일을 참고하여 템플릿 시트 ID를 입력하세요
NEXT_PUBLIC_SHEET_TEMPLATE_ID=your-template-sheet-id

# 구글 시트 연동 (선택사항 - 템플릿 방식 사용 시 불필요)
# GOOGLE_SHEETS_SETUP.md 파일을 참고하여 Apps Script 웹 앱 URL을 입력하세요
# 이 값을 설정하지 않으면 Firebase에만 저장됩니다
NEXT_PUBLIC_GOOGLE_SHEETS_URL=
